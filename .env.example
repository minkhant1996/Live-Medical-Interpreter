# ============================================
# MedInterpreter — Environment Variables
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- Gemini API (local dev only) ---
# Get your key from https://aistudio.google.com/
GOOGLE_API_KEY=your-gemini-api-key-here

# --- Google Cloud Project ---
# Required for Firestore and Cloud TTS
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# --- Server Port ---
# Defaults to 8080 (Cloud Run sets this automatically)
PORT=8080

# --- Vertex AI (production only) ---
# Set to "true" on Cloud Run — uses ADC instead of API key
# USE_VERTEX_AI=true
# GCP_REGION=us-central1

# --- Firestore Emulator (local dev) ---
# Uncomment to use the Firestore emulator instead of real Firestore
# FIRESTORE_EMULATOR_HOST=localhost:8080

# --- JWT Secret (optional) ---
# Auto-generated if not set. Set a fixed value for persistent sessions across restarts.
# JWT_SECRET=your-secret-here
