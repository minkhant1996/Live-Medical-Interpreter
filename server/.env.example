# Gemini API Key (required for LLM calls)
GOOGLE_API_KEY=your-gemini-api-key-here

# Google Cloud Project (optional - defaults to med-interpreter-dev)
GOOGLE_CLOUD_PROJECT=your-project-id

# JWT Secret (required - must be at least 32 characters)
JWT_SECRET=your-super-secret-jwt-key-at-least-32-chars

# GCS Bucket for image storage (optional - uses local storage if not set)
# GCS_BUCKET=your-bucket-name

# GCS Bucket for conversation audio (auto-created if not exists, 24h expiry)
# AUDIO_BUCKET_NAME=your-project-medinterpreter-audio

# Image storage path for local development (optional)
# IMAGE_STORAGE_PATH=/path/to/images
